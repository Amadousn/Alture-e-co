{% assign v = product.selected_or_first_available_variant %}<div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:4px 0 16px;"><span style="font-size:32px;font-weight:800;color:#211c17;line-height:1;">{{ v.price | money }}</span>{% if v.compare_at_price and v.compare_at_price > v.price %}<span style="font-size:20px;color:#d81f1f;text-decoration:line-through;">{{ v.compare_at_price | money }}</span>{% assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price %}<span style="background:#c15d2f;color:#fff;font-size:13px;font-weight:700;letter-spacing:.5px;padding:4px 11px;border-radius:20px;">-{{ pct }}%</span>{% endif %}</div>