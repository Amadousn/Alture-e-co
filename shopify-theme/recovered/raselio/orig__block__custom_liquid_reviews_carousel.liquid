      color: #6b6154;
    }
    .trustpilot-stars-{{block.id}} img {
      width: 85px;
      height: auto;
      margin-top: 6px;
    }
    .arrow-{{block.id}} {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      font-size: 22px;
      color: #c15d2f;
      z-index: 2;
    }
    .arrow-{{block.id}}.left { left: 0; }
    .arrow-{{block.id}}.right { right: 0; }
