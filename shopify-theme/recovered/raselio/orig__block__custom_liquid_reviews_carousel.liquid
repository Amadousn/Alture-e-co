    <div class="arrow-{{block.id}} right" onclick="nextReview{{block.id}}()">›</div>
  </div>
<script>
  (function(){
    var idx = 0;
    var wrap = document.getElementById('carouselWrapper{{block.id}}');
    var boxes = wrap.querySelectorAll('.review-box-{{block.id}}');
    var total = boxes.length;
    var startX, endX;
    function update(){ wrap.style.transform = 'translateX(' + (-idx * 100) + '%)'; }
    window.nextReview{{block.id}} = function(){ idx = (idx + 1) % total; update(); };
    window.prevReview{{block.id}} = function(){ idx = (idx - 1 + total) % total; update(); };
    window.startTouch{{block.id}} = function(e){ startX = e.touches[0].clientX; };
    window.moveTouch{{block.id}} = function(e){ endX = e.touches[0].clientX; if (startX - endX > 50) { nextReview{{block.id}}(); } else if (endX - startX > 50) { prevReview{{block.id}}(); } };
    window.endTouch{{block.id}} = function(){ startX = 0; endX = 0; };
    setInterval(function(){ nextReview{{block.id}}(); }, 5000);
  })();
</script>