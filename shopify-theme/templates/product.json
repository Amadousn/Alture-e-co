        "fit_accordion": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign fit_img = 'photo-08-fitting-check.png' | file_img_url: '900x' -%}\n<details class=\"au-fit\" style=\"border:1px solid rgba(var(--color-foreground),.14);border-radius:10px;padding:0;margin:1rem 0;\">\n  <summary style=\"list-style:none;cursor:pointer;display:grid;grid-template-columns:72px 1fr auto;gap:.9rem;align-items:center;padding:.8rem 1rem;\">\n    <span style=\"position:relative;display:block;width:72px;height:54px;border-radius:6px;overflow:hidden;background:#dfe6e5;\">\n      <img src=\"{{ fit_img }}\" alt=\"Checking two fingers of space under the belly strap\" width=\"72\" height=\"54\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n    </span>\n    <span><strong style=\"font-family:var(--font-heading-family);font-size:1rem;display:block;\">How to fit it</strong><span style=\"font-size:.9rem;opacity:.8;\">Two minutes the first time, thirty seconds after that.</span></span>\n    <span aria-hidden=\"true\" style=\"font-size:1.4rem;line-height:1;\">+</span>\n  </summary>\n  <div style=\"padding:0 1rem 1rem;\">\n    <img src=\"{{ fit_img }}\" alt=\"Owner's hands checking two fingers of space under the belly strap of the harness\" loading=\"lazy\" style=\"width:100%;height:auto;border-radius:8px;display:block;margin:.2rem 0 .9rem;\">\n    <ol style=\"margin:0 0 .8rem 1.1rem;padding:0;font-size:.95rem;line-height:1.5;\">\n      <li>Loosen all four sliders before the first fit.</li>\n      <li>Put it on and clip both buckles.</li>\n      <li>Tighten the neck straps first, then chest, then belly. Both sides evenly.</li>\n      <li>Two fingers flat under every strap. Tighter rubs, looser twists.</li>\n      <li>After five minutes of walking, re-check the belly strap.</li>\n    </ol>\n    <a href=\"/pages/fitting-guide\" style=\"font-size:.95rem;text-underline-offset:.2em;\">Read the full fitting guide</a>\n  </div>\n</details>\n<style>.au-fit summary::-webkit-details-marker{display:none}.au-fit[open] summary span[aria-hidden]{transform:rotate(45deg);display:inline-block}</style>"
          }
