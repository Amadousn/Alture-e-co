            "category": "Delivery & guarantee"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "category": "Harness & pulling",
            "question": "Will it really stop my dog from pulling?",
            "answer": "It stops pulling from working. The lead sits on the chest, so a surge turns your dog back towards you instead of dragging you forward. Most dogs ease off on the first walk; determined pullers take a few. You have 60 days to find out."
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "category": "Harness & pulling",
            "question": "What is the difference between the front and back clips?",
            "answer": "The front (chest) clip redirects a pull sideways, back towards you: use it on busy paths and for training. The back clip lets your dog walk freely once the lead stays slack. Same harness, one click to switch."
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "category": "Size & fit",
            "question": "How do I choose the right size?",
            "answer": "Measure the chest at its widest point, just behind the front legs, and match it to the size chart (XS to XL, 35 to 105 cm). Between sizes or thick double coat? Go up. Four adjustment points do the rest."
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "category": "Size & fit",
            "question": "What happens if the size is wrong?",
            "answer": "We swap it free within 60 days, one swap per order, prepaid both ways. Send us a side photo of your dog and the chest measurement and we'll confirm the size before you post it back."
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "category": "Delivery & guarantee",
            "question": "Is the matching lead included?",
            "answer": "Yes. The matching Classic Lead is added to every harness order automatically at checkout, at no cost. Clip it to the front ring for the first ten walks."
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "category": "Delivery & guarantee",
            "question": "How does the 60-day guarantee work?",
            "answer": "Use it for up to 60 days. If it hasn't changed your walks, we send a prepaid return label and refund the full price. You keep the lead."
          }
        }
      },
