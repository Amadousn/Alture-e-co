        "mech_t": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Back clip:</strong> the lead pulls from behind the shoulders, so leaning forward is easy and every step rewards it.</p><p><strong>Front clip:</strong> the lead attaches at the chest. When your dog surges, the tension turns their shoulders back towards you.</p><p>Less leverage, less pulling, and your arm stops taking the load. <a href=\"/products/front-clip-no-pull-harness\">See how it works</a></p>",
            "text_style": "body"
          }
        }
