    "mechanism": {
      "type": "image-with-text",
      "blocks": {
        "mech_cap": {
          "type": "caption",
          "settings": {
            "caption": "The mechanism",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "mech_h": {
          "type": "heading",
          "settings": {
            "heading": "Why the clip position changes everything.",
            "heading_size": "h1"
          }
        },
        "mech_t": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Back clip: your dog gets a full-body brace.</strong> The lead pulls from behind the shoulders, so leaning forward is easy and every step rewards it.</p><p><strong>Front clip: the pull is redirected.</strong> The lead attaches at the chest. When your dog surges, the tension turns their shoulders back towards you.</p><p><strong>Less leverage, less pulling.</strong> Your dog can't use its weight against you, so pulling stops working and your arm stops taking the load.</p>",
            "text_style": "body"
          }
        },
        "mech_b": {
          "type": "button",
          "settings": {
            "button_label": "Shop the harness — A$59",
            "button_link": "/products/front-clip-no-pull-harness",
            "button_style_secondary": false
