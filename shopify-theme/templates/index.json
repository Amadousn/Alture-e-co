        "hb_b1": {
          "type": "benefit",
          "settings": {
            "title": "Front-clip redirection",
            "text": "The lead clips to the chest ring. When your dog surges forward, their own momentum turns them back towards you. Pulling stops paying off, usually on the first walk.",
