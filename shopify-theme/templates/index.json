    "au_faq": {
      "type": "au-faq",
      "blocks": {
        "faq_q1": {
          "type": "q",
          "settings": {
            "question": "Will it really stop my dog from pulling?",
            "answer": "<p>It stops pulling from working. The lead sits on the chest, so a surge turns your dog back towards you instead of dragging you forward. Most dogs ease off on the first walk; determined pullers take a few. You have 60 days to find out.</p>"
          }
        },
        "faq_q2": {
          "type": "q",
          "settings": {
            "question": "Is it comfortable around the neck?",
            "answer": "<p>Nothing sits on the throat. The load goes onto the padded chest plate, and the neck straps are adjustable and sit low on the shoulders. No coughing, no gagging, even on a hard lunge.</p>"
          }
        },
        "faq_q3": {
          "type": "q",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Measure the chest at its widest point, just behind the front legs, and match it to the size chart (XS to XL, 35 to 105 cm). Between sizes or thick double coat? Go up. Four adjustment points do the rest.</p>"
          }
        },
        "faq_q4": {
          "type": "q",
          "settings": {
            "question": "What happens if the size is wrong?",
            "answer": "<p>We swap it free within 60 days, one swap per order, prepaid both ways. Send us a side photo of your dog and the chest measurement and we'll confirm the size before you post it back.</p>"
          }
        },
        "faq_q5": {
          "type": "q",
          "settings": {
            "question": "Is the matching lead included?",
            "answer": "<p>Yes. The matching Classic Lead is added to every harness order automatically at checkout, at no cost. Clip it to the front ring for the first ten walks.</p>"
          }
        },
        "faq_q6": {
          "type": "q",
          "settings": {
            "question": "How does the 60-day guarantee work?",
            "answer": "<p>Walk your dog in it for up to 60 days from delivery. If it hasn't changed your walks, contact us with your order number: we email a prepaid Australia Post label, you drop it at any post office, and the full price is refunded within 5 business days of the scan. You keep the lead.</p>"
          }
        }
      },
      "block_order": [
