    "benefits_tabs": {
      "type": "au-benefits-tabs",
      "blocks": {
        "hb_b1": {
          "type": "benefit",
          "settings": {
            "title": "Front-clip redirection",
            "text": "The lead clips to the chest ring. When your dog surges forward, their own momentum turns them sideways and back towards you. Pulling stops paying off.",
            "image": "shopify://shop_images/photo-11-front-clip-detail.png"
          }
        },
        "hb_b2": {
          "type": "benefit",
          "settings": {
            "title": "Less pressure on the neck",
            "text": "The load sits on the padded chest plate, not the throat. No coughing, no gagging, no strain on the trachea when the lead goes tight.",
            "image": "shopify://shop_images/photo-03-early-morning.png"
          }
        },
        "hb_b3": {
          "type": "benefit",
          "settings": {
            "title": "Adjustable everyday comfort",
            "text": "Four adjustment points and quick-release buckles for an even, twist-free fit. Two fingers under every strap and it's set for the day.",
            "image": "shopify://shop_images/photo-08-fitting-check.png"
          }
        },
        "hb_b4": {
          "type": "benefit",
          "settings": {
            "title": "Front and back walking modes",
            "text": "Front clip for control on busy paths. Back clip for a relaxed walk once the lead stays slack. Same harness, two modes.",
            "image": "shopify://shop_images/photo-05-bush-track.png"
          }
        }
      },
