        "pain_t": {
          "type": "text",
          "settings": {
            "text": "<ul><li><strong>Pulls the second the door opens.</strong></li><li><strong>Your shoulder or back aches after every walk.</strong></li><li><strong>You skip walks because they're a fight.</strong></li><li><strong>Dogs, bikes, runners: instant lunge, instant stress.</strong></li></ul><p>None of that is a bad dog. It's a lead attached to the wrong spot.</p>",
            "text_style": "body"
          }
        }
