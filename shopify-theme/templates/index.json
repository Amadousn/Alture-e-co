    "compare_walking_gear": {
      "type": "multicolumn",
      "blocks": {
        "compare_col_1": {
          "type": "column",
          "settings": {
            "title": "Flat collar",
            "text": "<p><strong>Where the force goes:</strong> throat.</p><p><strong>When the dog pulls:</strong> coughing, strain.</p><p><strong>In the heat:</strong> fine.</p><p><strong>Learning curve:</strong> none.</p><p><strong>Best for:</strong> ID tags.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "compare_col_2": {
          "type": "column",
          "settings": {
            "title": "Back-clip harness",
            "text": "<p><strong>Where the force goes:</strong> chest and shoulders, straight forward.</p><p><strong>When the dog pulls:</strong> dog can brace and pull harder.</p><p><strong>In the heat:</strong> depends on padding.</p><p><strong>Learning curve:</strong> none.</p><p><strong>Best for:</strong> dogs that already walk nicely, running.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "compare_col_3": {
          "type": "column",
          "settings": {
            "title": "Head halter",
            "text": "<p><strong>Where the force goes:</strong> muzzle and neck.</p><p><strong>When the dog pulls:</strong> head turns; many dogs paw it off.</p><p><strong>In the heat:</strong> often disliked.</p><p><strong>Learning curve:</strong> days to weeks of desensitising.</p><p><strong>Best for:</strong> some very strong dogs under a trainer.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "compare_col_4": {
          "type": "column",
          "settings": {
            "title": "Front-clip harness",
            "text": "<p><strong>Where the force goes:</strong> chest, redirected sideways.</p><p><strong>When the dog pulls:</strong> dog swings back towards you.</p><p><strong>In the heat:</strong> fine with breathable webbing.</p><p><strong>Learning curve:</strong> first walk.</p><p><strong>Best for:</strong> pullers, reactive dogs, strong dogs, sore owners.</p>",
            "link_label": "Shop the front-clip harness",
            "link": "/products/front-clip-no-pull-harness"
          }
        }
      },
      "block_order": [
        "compare_col_1",
        "compare_col_2",
        "compare_col_3",
        "compare_col_4"
