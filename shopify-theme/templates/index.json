        "hb_b2": {
          "type": "benefit",
          "settings": {
            "title": "Less pressure on the neck",
            "text": "The load sits on the padded chest plate, not the throat. No coughing, no gagging, no strain on the neck, however hard they hit the end of the lead.",
            "image": "shopify://shop_images/photo-03-early-morning.png",
            "tab": "Easy on the neck",
            "icon": "neck"
          }
        },
        "hb_b3": {
          "type": "benefit",
          "settings": {
            "title": "Adjustable everyday comfort",
            "text": "Four adjustment points and quick-release buckles for an even, twist-free fit. Two fingers under each strap and it stays put from the front door to the beach.",
            "image": "shopify://shop_images/photo-08-fitting-check.png",
            "tab": "Everyday comfort",
            "icon": "comfort"
          }
        },
        "hb_b4": {
          "type": "benefit",
          "settings": {
            "title": "Front and back walking modes",
            "text": "Front clip for control on busy paths. Back clip for a relaxed walk once the lead stays slack. Same harness, one click to switch.",
