    "pain_front_door": {
      "type": "image-with-text",
      "blocks": {
        "pain_cap": {
          "type": "caption",
          "settings": {
            "caption": "Sound familiar?",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
