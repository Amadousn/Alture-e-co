{%- comment -%}
  Four-benefit interactive tabs: one photo per benefit, manual tab switching (no autoplay).
  Written for this store; the original Aerozya "4 benefits" section was not recoverable.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign first_index = 0
-%}
<style>
  #AuBen-{{ sid }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #AuBen-{{ sid }} .au-ben__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  #AuBen-{{ sid }} .au-ben__head { max-width: 60ch; margin: 0 0 1.8rem; }
  #AuBen-{{ sid }} .au-ben__caption { font-family: var(--font-heading-family); font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .7rem; opacity: .75; }
  #AuBen-{{ sid }} h2 { margin: 0 0 .6rem; }
  #AuBen-{{ sid }} .au-ben__intro { margin: 0; font-size: 1.02rem; line-height: 1.5; }
  #AuBen-{{ sid }} .au-ben__grid { display: grid; grid-template-columns: 1fr; gap: 1.2rem; align-items: stretch; }
  #AuBen-{{ sid }} .au-ben__media { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 4 / 5; background: rgba(var(--color-foreground), .06); }
  #AuBen-{{ sid }} .au-ben__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s ease; }
  #AuBen-{{ sid }} .au-ben__media img.is-active { opacity: 1; }
  #AuBen-{{ sid }} .au-ben__tabs { display: flex; flex-direction: column; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  #AuBen-{{ sid }} .au-ben__tab {
    width: 100%; text-align: left; cursor: pointer; font: inherit; color: inherit;
    background: rgb(var(--color-background)); border: 1px solid rgba(var(--color-foreground), .14);
    border-radius: 10px; padding: 1rem 1.1rem; display: grid; grid-template-columns: 2.1rem 1fr; gap: .8rem; align-items: start;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  #AuBen-{{ sid }} .au-ben__tab[aria-selected="true"] { border-color: rgb(var(--color-button)); box-shadow: 0 0 0 1px rgb(var(--color-button)) inset; }
  #AuBen-{{ sid }} .au-ben__num { font-family: var(--font-heading-family); font-weight: 700; font-size: .95rem; width: 2.1rem; height: 2.1rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(var(--color-button), .12); color: rgb(var(--color-button)); }
  #AuBen-{{ sid }} .au-ben__tab[aria-selected="true"] .au-ben__num { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
  #AuBen-{{ sid }} .au-ben__title { font-family: var(--font-heading-family); font-weight: 700; font-size: 1.05rem; margin: .15rem 0 .25rem; display: block; }
  #AuBen-{{ sid }} .au-ben__text { margin: 0; font-size: .95rem; line-height: 1.45; opacity: .85; display: none; }
  #AuBen-{{ sid }} .au-ben__tab[aria-selected="true"] .au-ben__text { display: block; }
  #AuBen-{{ sid }} .au-ben__cta { margin-top: 1.4rem; }
  @media screen and (min-width: 750px) {
    #AuBen-{{ sid }} .au-ben__inner { padding: 0 5rem; }
    #AuBen-{{ sid }} .au-ben__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    #AuBen-{{ sid }} .au-ben__media { aspect-ratio: 1 / 1; align-self: start; }
    #AuBen-{{ sid }} .au-ben__text { display: block; }
    #AuBen-{{ sid }} .au-ben__tab { padding: 1.1rem 1.3rem; }
    {%- if section.settings.image_position == 'right' -%}
    #AuBen-{{ sid }} .au-ben__media { order: 2; }
    {%- endif -%}
  }
</style>
<div id="AuBen-{{ sid }}" class="au-ben color-{{ section.settings.color_scheme }} gradient">
  <div class="au-ben__inner">
    <div class="au-ben__head">
      {%- if section.settings.caption != blank -%}<p class="au-ben__caption">{{ section.settings.caption }}</p>{%- endif -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="au-ben__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="au-ben__grid">
      <div class="au-ben__media" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200', class: 'au-ben__img', data-index: forloop.index0, alt: block.settings.image.alt }}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <ul class="au-ben__tabs" role="tablist">
        {%- for block in section.blocks -%}
          <li role="presentation" {{ block.shopify_attributes }}>
            <button type="button" class="au-ben__tab" role="tab" data-index="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="au-ben__num">{{ forloop.index }}</span>
              <span>
                <span class="au-ben__title">{{ block.settings.title }}</span>
                <p class="au-ben__text">{{ block.settings.text }}</p>
              </span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="au-ben__cta"><a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('AuBen-{{ sid }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.au-ben__tab');
    var imgs = root.querySelectorAll('.au-ben__img');
    function show(i) {
      tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.index == i ? 'true' : 'false'); });
      imgs.forEach(function (im) { im.classList.toggle('is-active', im.dataset.index == i); });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { show(t.dataset.index); });
      t.addEventListener('keydown', function (e) {
        var i = parseInt(t.dataset.index, 10);
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); var n = tabs[(i + 1) % tabs.length]; n.focus(); show(n.dataset.index); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); var p = tabs[(i - 1 + tabs.length) % tabs.length]; p.focus(); show(p.dataset.index); }
      });
    });
    show(0);
  })();
</script>
{% schema %}
{
  "name": "AU benefits tabs",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things the harness does on every walk" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "select", "id": "image_position", "label": "Photo position (desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Front-clip redirection" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [ { "name": "AU benefits tabs", "blocks": [ { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" } ] } ]
}
{% endschema %}
