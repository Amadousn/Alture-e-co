{%- comment -%}
  Four benefits, two columns. Left: eyebrow, heading, a compact petrol navigation bar (four round icons +
  short labels), the active benefit's title and text, one filled CTA. Right: ONE large 4:5 photo that
  cross-fades when another benefit is selected. Mobile: eyebrow → heading → scrollable bar (part of the next
  item visible) → photo → title → text → full-width CTA. Only the first photo is loaded up front; the other
  three are attached when selected (or when their tab is hovered). Optional auto-advance (0 = off), stops
  on click, only runs while visible. Keyboard arrows, theme-editor block select.
  Section type and block setting ids kept (tab, icon, custom_icon, title, text, image).
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign dur = section.settings.autoplay_seconds | default: 0
-%}
<style>
  #AuBen-{{ sid }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; overflow: hidden; }
  #AuBen-{{ sid }} .au-ben__inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; display: flex; flex-direction: column; }
  #AuBen-{{ sid }} .au-ben__caption { font-family: var(--font-heading-family); font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .6rem; opacity: .75; }
  #AuBen-{{ sid }} h2 { margin: 0 0 .5rem; }
  #AuBen-{{ sid }} .au-ben__intro { margin: 0 0 .6rem; font-size: 1.02rem; line-height: 1.5; }
  #AuBen-{{ sid }} .au-ben__head { order: 1; margin-bottom: .9rem; }

  /* navigation bar */
  #AuBen-{{ sid }} .au-ben__bar { order: 2; display: flex; gap: 6px; margin: 0 0 1.1rem; padding: 6px; border-radius: 16px; background: rgb(var(--color-button)); box-shadow: 0 10px 26px rgba(var(--color-button), .18); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 6px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  #AuBen-{{ sid }} .au-ben__bar::-webkit-scrollbar { display: none; }
  #AuBen-{{ sid }} .au-ben__tab { flex: 0 0 auto; width: 42%; min-height: 72px; scroll-snap-align: start; box-sizing: border-box; appearance: none; border: 0; padding: 8px 6px; border-radius: 12px; background: transparent; color: rgba(var(--color-button-text), .82); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; font-family: var(--font-heading-family); font-weight: 700; font-size: .82rem; line-height: 1.2; text-align: center; cursor: pointer; transition: background .2s ease, color .2s ease; }
  #AuBen-{{ sid }} .au-ben__tab:hover { background: rgba(var(--color-button-text), .1); color: rgb(var(--color-button-text)); }
  #AuBen-{{ sid }} .au-ben__tab:focus-visible { outline: 2px solid rgb(var(--color-button-text)); outline-offset: -3px; }
  #AuBen-{{ sid }} .au-ben__tab.is-on { background: rgba(var(--color-button-text), .14); color: rgb(var(--color-button-text)); }
  #AuBen-{{ sid }} .au-ben__ico { width: 40px; height: 40px; border-radius: 50%; background: rgba(var(--color-button-text), .9); color: rgb(var(--color-button)); display: flex; align-items: center; justify-content: center; transition: box-shadow .2s ease, transform .2s ease, background .2s ease; }
  #AuBen-{{ sid }} .au-ben__ico svg { width: 19px; height: 19px; }
  #AuBen-{{ sid }} .au-ben__ico img { width: 19px; height: 19px; object-fit: contain; }
  #AuBen-{{ sid }} .au-ben__tab.is-on .au-ben__ico { background: rgb(var(--color-button-text)); box-shadow: 0 0 0 2px rgb(var(--color-button)), 0 0 0 4px rgb(var(--color-button-text)); transform: scale(1.04); }
  #AuBen-{{ sid }} .au-ben__name { max-width: 100%; }

  /* photo (one at a time) */
  #AuBen-{{ sid }} .au-ben__card { order: 3; position: relative; width: 100%; margin: 0 0 1rem; aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; background: rgba(var(--color-foreground), .06); box-shadow: 0 14px 34px rgba(19,38,43,.12); }
  #AuBen-{{ sid }} .au-ben__img { position: absolute; inset: 0; opacity: 0; transform: scale(1.03); transition: opacity .5s ease, transform 1.1s ease; }
  #AuBen-{{ sid }} .au-ben__img.is-on { opacity: 1; transform: scale(1); }
  #AuBen-{{ sid }} .au-ben__img img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
  #AuBen-{{ sid }} .au-ben__img img[data-src] { visibility: hidden; }

  /* active benefit text */
  #AuBen-{{ sid }} .au-ben__panels { order: 4; margin-bottom: 1.2rem; }
  #AuBen-{{ sid }} .au-ben__panel[hidden] { display: none; }
  #AuBen-{{ sid }} .au-ben__panel.is-on { animation: au-ben-in-{{ sid }} .35s ease; }
  @keyframes au-ben-in-{{ sid }} { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  #AuBen-{{ sid }} .au-ben__h { margin: 0 0 .5rem; font-family: var(--font-heading-family); font-size: 1.35rem; line-height: 1.2; font-weight: 700; }
  #AuBen-{{ sid }} .au-ben__p { margin: 0; font-size: 1rem; line-height: 1.55; opacity: .9; max-width: 50ch; }
  #AuBen-{{ sid }} .au-ben__cta { order: 5; }
  #AuBen-{{ sid }} .au-ben__cta .button { width: 100%; }
  @media (prefers-reduced-motion: reduce) { #AuBen-{{ sid }} .au-ben__panel.is-on { animation: none; } #AuBen-{{ sid }} .au-ben__img, #AuBen-{{ sid }} .au-ben__ico, #AuBen-{{ sid }} .au-ben__tab { transition: none; } }

  @media screen and (min-width: 750px) {
    #AuBen-{{ sid }} .au-ben__inner { padding: 0 5rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(32px, 5vw, 72px); align-items: center; }
    #AuBen-{{ sid }} .au-ben__head, #AuBen-{{ sid }} .au-ben__bar, #AuBen-{{ sid }} .au-ben__panels, #AuBen-{{ sid }} .au-ben__cta { grid-column: 1; }
    #AuBen-{{ sid }} .au-ben__card { grid-column: 2; grid-row: 1 / span 4; margin: 0; max-height: 640px; border-radius: 20px; }
    {%- if section.settings.image_position == 'left' -%}
    #AuBen-{{ sid }} .au-ben__head, #AuBen-{{ sid }} .au-ben__bar, #AuBen-{{ sid }} .au-ben__panels, #AuBen-{{ sid }} .au-ben__cta { grid-column: 2; }
    #AuBen-{{ sid }} .au-ben__card { grid-column: 1; }
    {%- endif -%}
    #AuBen-{{ sid }} .au-ben__head { margin-bottom: 1.2rem; }
    #AuBen-{{ sid }} .au-ben__bar { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 6px; margin: 0 0 1.4rem; overflow: visible; }
    #AuBen-{{ sid }} .au-ben__tab { width: auto; min-height: 84px; padding: 8px 5px; gap: 5px; font-size: .8rem; line-height: 1.15; }
    #AuBen-{{ sid }} .au-ben__ico { width: 40px; height: 40px; }
    #AuBen-{{ sid }} .au-ben__h { font-size: 1.6rem; }
    #AuBen-{{ sid }} .au-ben__cta .button { width: auto; min-width: 17rem; }
  }
</style>
<div id="AuBen-{{ sid }}" class="au-ben color-{{ section.settings.color_scheme }} gradient{% if dur > 0 %} is-auto{% endif %}" data-dur="{{ dur }}">
  <div class="au-ben__inner">
    <div class="au-ben__head">
      {%- if section.settings.caption != blank -%}<p class="au-ben__caption">{{ section.settings.caption }}</p>{%- endif -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="au-ben__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="au-ben__bar" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button type="button" class="au-ben__tab{% if forloop.first %} is-on{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-i="{{ forloop.index0 }}" id="{{ block.id }}-tab" aria-controls="{{ block.id }}-panel" {{ block.shopify_attributes }}>
          <span class="au-ben__ico" aria-hidden="true">
            {%- if block.settings.custom_icon != blank -%}
              <img src="{{ block.settings.custom_icon | image_url: width: 76 }}" alt="" loading="lazy" width="19" height="19">
            {%- else -%}
              {%- render 'au-benefit-icon', icon: block.settings.icon -%}
            {%- endif -%}
          </span>
          <span class="au-ben__name">{{ block.settings.tab | default: block.settings.title | escape }}</span>
        </button>
      {%- endfor -%}
    </div>

    <div class="au-ben__card">
      {%- for block in section.blocks -%}
        <div class="au-ben__img{% if forloop.first %} is-on{% endif %}" data-i="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- if block.settings.image != blank -%}
            {%- assign b_img = block.settings.image -%}
            {%- assign b_alt = b_img.alt | default: block.settings.title | escape -%}
            {%- if forloop.first -%}
              {{ b_img | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 520px, 92vw', widths: '400, 600, 900, 1100', alt: b_alt }}
            {%- else -%}
              <img data-src="{{ b_img | image_url: width: 900 }}" data-srcset="{{ b_img | image_url: width: 400 }} 400w, {{ b_img | image_url: width: 600 }} 600w, {{ b_img | image_url: width: 900 }} 900w, {{ b_img | image_url: width: 1100 }} 1100w" sizes="(min-width: 750px) 520px, 92vw" alt="{{ b_alt }}" width="{{ b_img.width }}" height="{{ b_img.height }}">
            {%- endif -%}
          {%- elsif request.design_mode -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'au-ben__placeholder' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="au-ben__panels">
      {%- for block in section.blocks -%}
        <div class="au-ben__panel{% if forloop.first %} is-on{% endif %}" data-i="{{ forloop.index0 }}" id="{{ block.id }}-panel" role="tabpanel" aria-labelledby="{{ block.id }}-tab" tabindex="0"{% unless forloop.first %} hidden{% endunless %}>
          <h3 class="au-ben__h">{{ block.settings.title | escape }}</h3>
          <p class="au-ben__p">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="au-ben__cta"><a class="button button--primary" href="{{ section.settings.button_link | default: '/' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('AuBen-{{ sid }}'); if (!root || root.dataset.init) return; root.dataset.init = '1';
    var tabs = [].slice.call(root.querySelectorAll('.au-ben__tab'));
    var panels = [].slice.call(root.querySelectorAll('.au-ben__panel'));
    var imgs = [].slice.call(root.querySelectorAll('.au-ben__img'));
    var bar = root.querySelector('.au-ben__bar');
    var dur = parseInt(root.dataset.dur, 10) || 0, cur = 0, timer = null;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function load(i) {
      var im = imgs[i] && imgs[i].querySelector('img[data-src]'); if (!im) return;
      im.srcset = im.getAttribute('data-srcset'); im.src = im.getAttribute('data-src');
      im.removeAttribute('data-srcset'); im.removeAttribute('data-src');
    }
    function show(i) {
      cur = (i + tabs.length) % tabs.length;
      load(cur);
      tabs.forEach(function (t, k) { var on = k === cur; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); t.setAttribute('tabindex', on ? '0' : '-1'); });
      panels.forEach(function (p, k) { var on = k === cur; p.classList.toggle('is-on', on); p.hidden = !on; });
      imgs.forEach(function (m, k) { var on = k === cur; m.classList.toggle('is-on', on); if (on) { m.removeAttribute('aria-hidden'); } else { m.setAttribute('aria-hidden', 'true'); } });
      var t = tabs[cur];
      if (t && window.innerWidth < 750) { bar.scrollTo({ left: Math.max(0, t.offsetLeft - 6), behavior: reduce ? 'auto' : 'smooth' }); }
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() { if (dur <= 0 || reduce || tabs.length < 2) { root.classList.remove('is-auto'); return; } stop(); timer = setInterval(function () { show(cur + 1); }, dur * 1000); }
    function manual(i) { stop(); root.classList.remove('is-auto'); show(i); }
    tabs.forEach(function (t, k) {
      t.addEventListener('click', function () { manual(k); });
      t.addEventListener('mouseenter', function () { load(k); });
      t.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); manual(k + 1); tabs[cur].focus(); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); manual(k - 1); tabs[cur].focus(); }
      });
    });
    if ('IntersectionObserver' in window) { new IntersectionObserver(function (en) { en.forEach(function (e) { if (e.isIntersecting) { if (!timer && root.classList.contains('is-auto')) start(); } else { stop(); } }); }, { threshold: .25 }).observe(root); } else { start(); }
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else if (root.classList.contains('is-auto') && !timer) start(); });
    if (window.Shopify && Shopify.designMode) { document.addEventListener('shopify:block:select', function (e) { var i = tabs.findIndex(function (t) { return t.id === e.detail.blockId + '-tab'; }); if (i > -1) manual(i); }); }
    show(0);
  })();
</script>
{% schema %}
{
  "name": "AU benefits tabs",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things the harness does on every walk" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "range", "id": "autoplay_seconds", "min": 0, "max": 12, "step": 1, "unit": "s", "label": "Auto-advance (0 = off, stops on click)", "default": 0 },
    { "type": "select", "id": "image_position", "label": "Photo position (desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "right" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose your harness" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "tab", "label": "Short label (navigation bar)", "default": "Redirects pulling" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "redirect", "options": [ { "value": "redirect", "label": "Redirect arrow" }, { "value": "neck", "label": "Shield (neck protection)" }, { "value": "comfort", "label": "Sliders (adjustable comfort)" }, { "value": "modes", "label": "Two arrows (front / back modes)" }, { "value": "check", "label": "Check" } ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (replaces the icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Front-clip redirection" },
        { "type": "textarea", "id": "text", "label": "Text (1 to 2 lines)" },
        { "type": "image_picker", "id": "image", "label": "Photo (4:5)" }
      ]
    }
  ],
  "presets": [ { "name": "AU benefits tabs", "blocks": [ { "type": "benefit" }, { "type": "benefit", "settings": { "tab": "Easy on the neck", "icon": "neck", "title": "Less pressure on the neck" } }, { "type": "benefit", "settings": { "tab": "Everyday comfort", "icon": "comfort", "title": "Adjustable everyday comfort" } }, { "type": "benefit", "settings": { "tab": "Two walking modes", "icon": "modes", "title": "Front and back walking modes" } } ] } ]
}
{% endschema %}
