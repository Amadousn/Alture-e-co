{%- comment -%}
  Four benefits, each with its own large 4:5 photo. Desktop: 2 x 2 grid of cards (photo, number or icon,
  title, short text). Mobile: horizontal carousel (one card plus a peek of the next, scroll-snap, dots).
  Above the cards, a segmented navigation of four pills (icon in a small circle + short label): clicking
  a pill highlights the matching card and scrolls it into view; on mobile the active pill follows the swipe.
  One filled CTA after the cards. Colours come from the theme colour scheme.
  Section type kept as "au-benefits-tabs" so existing templates keep working; block setting ids unchanged
  (tab, icon, custom_icon, title, text, image).
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign badge = section.settings.badge | default: 'number'
-%}
<style>
  #AuBen-{{ sid }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; overflow: hidden; }
  #AuBen-{{ sid }} .au-ben__inner { max-width: 1040px; margin: 0 auto; padding: 0 1.5rem; }
  #AuBen-{{ sid }} .au-ben__caption { font-family: var(--font-heading-family); font-size: .76rem; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .6rem; opacity: .75; }
  #AuBen-{{ sid }} h2 { margin: 0 0 .5rem; }
  #AuBen-{{ sid }} .au-ben__intro { margin: 0 0 .4rem; font-size: 1.02rem; line-height: 1.5; max-width: 60ch; }
  #AuBen-{{ sid }} .au-ben__head { margin-bottom: 1.1rem; }

  /* segmented navigation */
  #AuBen-{{ sid }} .au-ben__nav { display: flex; gap: .5rem; margin: 0 -1.5rem 1.1rem; padding: .15rem 1.5rem .35rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 1.5rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  #AuBen-{{ sid }} .au-ben__nav::-webkit-scrollbar { display: none; }
  #AuBen-{{ sid }} .au-ben__pill { flex: 0 0 auto; width: min(64%, 230px); scroll-snap-align: start; box-sizing: border-box; display: flex; align-items: center; gap: .6rem; min-height: 48px; padding: .45rem .95rem .45rem .5rem; border: 1px solid rgba(var(--color-foreground), .18); border-radius: 999px; background: rgba(var(--color-foreground), .035); color: rgb(var(--color-foreground)); font-family: var(--font-heading-family); font-weight: 700; font-size: .92rem; line-height: 1.2; text-align: left; cursor: pointer; appearance: none; transition: background .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease; }
  #AuBen-{{ sid }} .au-ben__pill:hover { background: rgba(var(--color-button), .1); border-color: rgba(var(--color-button), .6); }
  #AuBen-{{ sid }} .au-ben__pill:focus-visible { outline: 3px solid rgba(var(--color-button), .45); outline-offset: 2px; }
  #AuBen-{{ sid }} .au-ben__pill.is-on { background: rgb(var(--color-button)); border-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); box-shadow: 0 6px 16px rgba(var(--color-button), .25); }
  #AuBen-{{ sid }} .au-ben__ico { flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid rgba(var(--color-button), .55); background: rgb(var(--color-background)); color: rgb(var(--color-button)); display: flex; align-items: center; justify-content: center; transition: background .2s ease, border-color .2s ease, color .2s ease; }
  #AuBen-{{ sid }} .au-ben__ico svg { width: 17px; height: 17px; }
  #AuBen-{{ sid }} .au-ben__ico img { width: 17px; height: 17px; object-fit: contain; }
  #AuBen-{{ sid }} .au-ben__pill.is-on .au-ben__ico { background: rgba(var(--color-button-text), .16); border-color: rgba(var(--color-button-text), .6); color: rgb(var(--color-button-text)); }
  #AuBen-{{ sid }} .au-ben__pill.is-on .au-ben__ico img { filter: brightness(0) invert(1); }
  #AuBen-{{ sid }} .au-ben__name { min-width: 0; }

  /* cards */
  #AuBen-{{ sid }} .au-ben__track { position: relative; display: flex; gap: .9rem; margin: 0 -1.5rem; padding: .25rem 1.5rem .5rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 1.5rem; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  #AuBen-{{ sid }} .au-ben__track::-webkit-scrollbar { display: none; }
  #AuBen-{{ sid }} .au-ben__card { flex: 0 0 88%; max-width: 420px; scroll-snap-align: start; box-sizing: border-box; border-radius: 16px; overflow: hidden; background: rgb(var(--color-background)); border: 1px solid rgba(var(--color-foreground), .1); box-shadow: 0 10px 28px rgba(19,38,43,.08); transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease; }
  #AuBen-{{ sid }} .au-ben__card.is-on { border-color: rgb(var(--color-button)); box-shadow: 0 0 0 2px rgb(var(--color-button)), 0 16px 36px rgba(19,38,43,.14); }
  #AuBen-{{ sid }} .au-ben__photo { position: relative; aspect-ratio: 4 / 5; background: rgba(var(--color-foreground), .06); }
  #AuBen-{{ sid }} .au-ben__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
  #AuBen-{{ sid }} .au-ben__badge { position: absolute; top: .8rem; left: .8rem; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.94); color: #13262B; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading-family); font-weight: 700; font-size: .84rem; letter-spacing: .02em; box-shadow: 0 2px 8px rgba(0,0,0,.15); transition: background .2s ease, color .2s ease; }
  #AuBen-{{ sid }} .au-ben__badge svg { width: 18px; height: 18px; }
  #AuBen-{{ sid }} .au-ben__card.is-on .au-ben__badge { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
  #AuBen-{{ sid }} .au-ben__body { padding: .95rem 1rem 1.1rem; }
  #AuBen-{{ sid }} .au-ben__h { margin: 0 0 .35rem; font-family: var(--font-heading-family); font-size: 1.15rem; line-height: 1.25; font-weight: 700; }
  #AuBen-{{ sid }} .au-ben__p { margin: 0; font-size: .95rem; line-height: 1.5; opacity: .9; }

  /* dots (mobile) */
  #AuBen-{{ sid }} .au-ben__dots { display: flex; justify-content: center; gap: 6px; margin: .3rem 0 0; padding: 0; list-style: none; }
  #AuBen-{{ sid }} .au-ben__dot { width: 7px; height: 7px; border-radius: 50%; border: 0; padding: 0; background: rgba(var(--color-foreground), .22); cursor: pointer; transition: background .2s, transform .2s; }
  #AuBen-{{ sid }} .au-ben__dot.is-on { background: rgb(var(--color-button)); transform: scale(1.25); }
  #AuBen-{{ sid }} .au-ben__cta { margin-top: 1.25rem; text-align: center; }
  #AuBen-{{ sid }} .au-ben__cta .button { width: 100%; }
  @media (prefers-reduced-motion: reduce) { #AuBen-{{ sid }} .au-ben__card, #AuBen-{{ sid }} .au-ben__pill, #AuBen-{{ sid }} .au-ben__badge { transition: none; } }

  @media screen and (min-width: 750px) {
    #AuBen-{{ sid }} .au-ben__inner { padding: 0 2.5rem; }
    #AuBen-{{ sid }} .au-ben__head { text-align: center; margin-bottom: 1.3rem; }
    #AuBen-{{ sid }} .au-ben__intro { margin-left: auto; margin-right: auto; }
    #AuBen-{{ sid }} .au-ben__nav { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: .6rem; margin: 0 0 1.4rem; padding: 0; overflow: visible; }
    #AuBen-{{ sid }} .au-ben__pill { width: auto; min-width: 0; justify-content: center; min-height: 52px; padding: .45rem .9rem .45rem .6rem; }
    #AuBen-{{ sid }} .au-ben__track { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: 0; padding: 0; overflow: visible; }
    #AuBen-{{ sid }} .au-ben__card { flex: none; max-width: none; }
    #AuBen-{{ sid }} .au-ben__card:hover { transform: translateY(-2px); }
    #AuBen-{{ sid }} .au-ben__badge { width: 42px; height: 42px; font-size: .9rem; top: 1rem; left: 1rem; }
    #AuBen-{{ sid }} .au-ben__body { padding: 1.1rem 1.25rem 1.3rem; }
    #AuBen-{{ sid }} .au-ben__h { font-size: 1.3rem; }
    #AuBen-{{ sid }} .au-ben__p { font-size: 1rem; }
    #AuBen-{{ sid }} .au-ben__dots { display: none; }
    #AuBen-{{ sid }} .au-ben__cta { margin-top: 1.75rem; }
    #AuBen-{{ sid }} .au-ben__cta .button { width: auto; min-width: 17rem; }
  }
</style>
<div id="AuBen-{{ sid }}" class="au-ben color-{{ section.settings.color_scheme }} gradient">
  <div class="au-ben__inner">
    <div class="au-ben__head">
      {%- if section.settings.caption != blank -%}<p class="au-ben__caption">{{ section.settings.caption }}</p>{%- endif -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="au-ben__intro rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <nav class="au-ben__nav" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button type="button" class="au-ben__pill{% if forloop.first %} is-on{% endif %}" data-i="{{ forloop.index0 }}" aria-controls="{{ block.id }}-card" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          <span class="au-ben__ico" aria-hidden="true">
            {%- if block.settings.custom_icon != blank -%}
              <img src="{{ block.settings.custom_icon | image_url: width: 68 }}" alt="" loading="lazy" width="17" height="17">
            {%- else -%}
              {%- render 'au-benefit-icon', icon: block.settings.icon -%}
            {%- endif -%}
          </span>
          <span class="au-ben__name">{{ block.settings.tab | default: block.settings.title | escape }}</span>
        </button>
      {%- endfor -%}
    </nav>

    <div class="au-ben__track" role="list">
      {%- for block in section.blocks -%}
        <article class="au-ben__card{% if forloop.first %} is-on{% endif %}" id="{{ block.id }}-card" data-i="{{ forloop.index0 }}" role="listitem">
          <div class="au-ben__photo">
            {%- if block.settings.image != blank -%}
              {%- assign b_alt = block.settings.image.alt | default: block.settings.title | escape -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 500px, 84vw', widths: '400, 600, 800, 1000', alt: b_alt }}
            {%- elsif request.design_mode -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'au-ben__placeholder' }}
            {%- endif -%}
            <span class="au-ben__badge" aria-hidden="true">
              {%- if badge == 'icon' -%}
                {%- if block.settings.custom_icon != blank -%}<img src="{{ block.settings.custom_icon | image_url: width: 72 }}" alt="" width="18" height="18">{%- else -%}{%- render 'au-benefit-icon', icon: block.settings.icon -%}{%- endif -%}
              {%- else -%}
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              {%- endif -%}
            </span>
          </div>
          <div class="au-ben__body">
            <h3 class="au-ben__h">{{ block.settings.title | escape }}</h3>
            <p class="au-ben__p">{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <ul class="au-ben__dots" aria-hidden="true">
        {%- for block in section.blocks -%}<li><button type="button" class="au-ben__dot{% if forloop.first %} is-on{% endif %}" data-i="{{ forloop.index0 }}" tabindex="-1"></button></li>{%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="au-ben__cta"><a class="button button--primary" href="{{ section.settings.button_link | default: '/' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('AuBen-{{ sid }}'); if (!root || root.dataset.init) return; root.dataset.init = '1';
    var pills = [].slice.call(root.querySelectorAll('.au-ben__pill'));
    var cards = [].slice.call(root.querySelectorAll('.au-ben__card'));
    var dots = [].slice.call(root.querySelectorAll('.au-ben__dot'));
    var nav = root.querySelector('.au-ben__nav'), track = root.querySelector('.au-ben__track');
    var cur = 0, lock = 0, raf = null;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var motion = reduce ? 'auto' : 'smooth';
    function mobile() { return window.innerWidth < 750; }
    function mark(i) {
      cur = (i + cards.length) % cards.length;
      pills.forEach(function (p, k) { var on = k === cur; p.classList.toggle('is-on', on); p.setAttribute('aria-current', on ? 'true' : 'false'); });
      cards.forEach(function (c, k) { c.classList.toggle('is-on', k === cur); });
      dots.forEach(function (d, k) { d.classList.toggle('is-on', k === cur); });
      var p = pills[cur];
      if (p && mobile()) { nav.scrollTo({ left: Math.max(0, p.offsetLeft - 24), behavior: motion }); }
    }
    function go(i, focusPill) {
      mark(i);
      var c = cards[cur]; if (!c) return;
      if (mobile()) { lock = Date.now() + 700; track.scrollTo({ left: Math.max(0, c.offsetLeft - 24), behavior: motion }); }
      else { var r = c.getBoundingClientRect(); if (r.top < 0 || r.bottom > window.innerHeight) { c.scrollIntoView({ block: 'nearest', behavior: motion }); } }
      if (focusPill && pills[cur]) pills[cur].focus();
    }
    pills.forEach(function (p, k) {
      p.addEventListener('click', function () { go(k); });
      p.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); go(k + 1, true); }
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); go(k - 1, true); }
      });
    });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { go(k); }); });
    track.addEventListener('scroll', function () {
      if (!mobile() || Date.now() < lock) return;
      if (raf) return;
      raf = requestAnimationFrame(function () {
        raf = null;
        var mid = track.scrollLeft + track.clientWidth / 2, best = 0, dist = Infinity;
        cards.forEach(function (c, k) { var d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid); if (d < dist) { dist = d; best = k; } });
        if (best !== cur) mark(best);
      });
    }, { passive: true });
    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', function (e) { var i = pills.findIndex(function (p) { return p.getAttribute('aria-controls') === e.detail.blockId + '-card'; }); if (i > -1) go(i); });
    }
    mark(0);
  })();
</script>
{% schema %}
{
  "name": "AU benefits",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things the harness does on every walk" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "select", "id": "badge", "label": "Badge on each photo", "default": "number", "options": [ { "value": "number", "label": "Number (01–04)" }, { "value": "icon", "label": "Icon" } ] },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose your harness" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "tab", "label": "Short label (navigation pill)", "default": "Redirects pulling" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "redirect", "options": [ { "value": "redirect", "label": "Redirect arrow" }, { "value": "neck", "label": "Shield (neck protection)" }, { "value": "comfort", "label": "Sliders (adjustable comfort)" }, { "value": "modes", "label": "Two arrows (front / back modes)" }, { "value": "check", "label": "Check" } ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (replaces the icon)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Front-clip redirection" },
        { "type": "textarea", "id": "text", "label": "Text (1 to 2 lines)" },
        { "type": "image_picker", "id": "image", "label": "Photo (4:5)" }
      ]
    }
  ],
  "presets": [ { "name": "AU benefits", "blocks": [ { "type": "benefit" }, { "type": "benefit", "settings": { "tab": "Easy on the neck", "icon": "neck", "title": "Less pressure on the neck" } }, { "type": "benefit", "settings": { "tab": "Everyday comfort", "icon": "comfort", "title": "Adjustable everyday comfort" } }, { "type": "benefit", "settings": { "tab": "Two walking modes", "icon": "modes", "title": "Front and back walking modes" } } ] } ]
}
{% endschema %}
