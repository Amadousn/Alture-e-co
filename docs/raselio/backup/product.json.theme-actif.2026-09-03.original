    "custom_liquid_slider_ba": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div style=\"max-width:900px;margin:0 auto;padding:0 16px;text-align:center;\">\n  <div style=\"font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#c15d2f;font-weight:700;margin-bottom:8px;\">La différence RASELIO</div>\n  <h2 style=\"font-size:34px;line-height:1.15;color:#211c17;font-weight:800;margin:0 0 10px;\">Tondeuse classique <span style=\"color:#8a8178;font-weight:600;\">vs</span> RASELIO Pro</h2>\n  <p style=\"font-size:15px;line-height:1.5;color:#6b6154;max-width:520px;margin:0 auto 26px;\">Rougeurs, tiraillements, poils incarnés : ce n'est pas toi qui t'y prends mal, c'est l'outil qui n'est pas fait pour cette peau. Glisse le curseur.</p>\n  <div id=\"raselioBA\" style=\"--p:50%;position:relative;width:100%;max-width:440px;margin:0 auto;aspect-ratio:896/1200;border-radius:20px;overflow:hidden;box-shadow:0 18px 40px rgba(33,28,23,.18);cursor:ew-resize;user-select:none;-webkit-user-select:none;touch-action:pan-y;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/raselio-apres-pro.png?v=1786925424\" alt=\"Peau nette avec RASELIO Pro\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;\">\n    <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/raselio-avant-classique-2.png?v=1786966135\" alt=\"Peau irritée après une tondeuse classique\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;clip-path:inset(0 calc(100% - var(--p)) 0 0);-webkit-clip-path:inset(0 calc(100% - var(--p)) 0 0);\">\n    <div style=\"position:absolute;bottom:16px;left:14px;background:rgba(33,28,23,.80);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:1px;padding:6px 12px;border-radius:30px;\">TONDEUSE CLASSIQUE</div>\n    <div style=\"position:absolute;bottom:16px;right:14px;background:#c15d2f;color:#fff;font-size:11.5px;font-weight:700;letter-spacing:1px;padding:6px 12px;border-radius:30px;\">RASELIO PRO</div>\n    <div style=\"position:absolute;top:0;bottom:0;left:var(--p);width:3px;background:#f7f3ec;transform:translateX(-1.5px);box-shadow:0 0 10px rgba(0,0,0,.35);pointer-events:none;\">\n      <div style=\"position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:50%;background:#f7f3ec;box-shadow:0 3px 12px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;color:#c15d2f;font-size:20px;font-weight:900;\">↔</div>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n  var el=document.getElementById('raselioBA'); if(!el||el.dataset.init)return; el.dataset.init='1';\n  var dragging=false;\n  function setP(x){var r=el.getBoundingClientRect();var p=(x-r.left)/r.width*100;p=Math.max(0,Math.min(100,p));el.style.setProperty('--p',p+'%');}\n  function pt(e){return e.touches&&e.touches[0]?e.touches[0].clientX:e.clientX;}\n  el.addEventListener('mousedown',function(e){dragging=true;setP(pt(e));});\n  window.addEventListener('mousemove',function(e){if(dragging)setP(pt(e));});\n  window.addEventListener('mouseup',function(){dragging=false;});\n  el.addEventListener('touchstart',function(e){dragging=true;setP(pt(e));},{passive:true});\n  window.addEventListener('touchmove',function(e){if(dragging)setP(pt(e));},{passive:true});\n  window.addEventListener('touchend',function(){dragging=false;});\n})();\n</script>",
        "color_scheme": "background-1",
        "padding_top": 24,
        "padding_bottom": 40
      }
    },
