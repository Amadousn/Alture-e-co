        "custom_liquid_benefits": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<p style=\"font-size:16px;line-height:1.5;color:#211c17;margin:0 0 12px;\"><strong>Cette zone, tu la rases en retenant ton souffle.</strong> LED intégrée : tu vois enfin ce que tu fais, même dans les plis. Tête arrondie qui suit la peau au lieu de la pincer. Lames céramique pensées pour les testicules, pas pour une barbe. Le geste reste sous contrôle, du début à la fin.</p>"
          }
