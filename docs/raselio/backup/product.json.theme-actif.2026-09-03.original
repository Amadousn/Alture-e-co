        "custom_liquid_reviews_carousel": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n    .carousel-container-{{block.id}} {\n      width: 100%;\n      overflow: hidden;\n      height: 110px;\n      position: relative;\n      touch-action: pan-y;\n      margin-top: 14px;\n    }\n    .carousel-wrapper-{{block.id}} {\n      display: flex;\n      transition: transform 0.5s ease-in-out;\n    }\n    .review-box-{{block.id}} {\n      flex: 0 0 100%;\n      box-sizing: border-box;\n      padding: 10px;\n      display: flex;\n      align-items: center;\n      text-align: left;\n      margin: 0;\n    }\n    .product-image-{{block.id}} {\n      max-width: 70px;\n      height: auto;\n      border: 0px solid #ddd;\n      border-radius: 12px;\n      margin-right: 10px;\n      margin-bottom: 5px;\n      object-fit: cover;\n      aspect-ratio: 1/1;\n    }\n    .review-text-{{block.id}} {\n      font-size: 12px;\n      color: #211c17;\n      margin: 0;\n      line-height: 1.3;\n      font-style: italic;\n    }\n    .trustpilot-container-{{block.id}} {\n      display: flex;\n      align-items: baseline;\n      font-size: 12px;\n    }\n    .trustpilot-name-{{block.id}} {\n      margin-right: 5px;\n      color: #6b6154;\n    }\n    .trustpilot-stars-{{block.id}} img {\n      width: 85px;\n      height: auto;\n      margin-top: 6px;\n    }\n    .arrow-{{block.id}} {\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      cursor: pointer;\n      font-size: 22px;\n      color: #c15d2f;\n      z-index: 2;\n    }\n    .arrow-{{block.id}}.left { left: 0; }\n    .arrow-{{block.id}}.right { right: 0; }\n  </style>\n<div class=\"carousel-container-{{block.id}}\" ontouchstart=\"startTouch{{block.id}}(event)\" ontouchmove=\"moveTouch{{block.id}}(event)\" ontouchend=\"endTouch{{block.id}}()\">\n    <div class=\"arrow-{{block.id}} left\" onclick=\"prevReview{{block.id}}()\">‹</div>\n    <div class=\"carousel-wrapper-{{block.id}}\" id=\"carouselWrapper{{block.id}}\">\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/WhatsApp_Image_2026-07-25_at_05.08.51.jpg\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Reçue hier, testée ce matin : pas une seule coupure, même en bas. Bien plus rassurant qu'avec ma tondeuse à barbe.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Maxime L.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/WhatsApp_Image_2026-07-25_at_05.08.51_1.jpg\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Je l'utilise sous la douche, résultat nickel et pas d'irritation le lendemain. Prise en main simple, livraison rapide.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Kevin D.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_91f0e2bb-11f0-4b44-83bd-38fed59027fc.png\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"J'avais toujours peur de me couper à cet endroit. Là je vois ce que je fais avec la LED, c'est propre et confortable. Je recommande.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Thomas B.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_bf6401e2-7d03-4041-a5e0-4beb9e9a70a2.png\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Beaucoup plus rassurant pour la zone intime : on règle la hauteur, on passe sans appuyer et c'est net.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Lucas M.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_91f0e2bb-11f0-4b44-83bd-38fed59027fc.png?v=1786545236\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Cette zone était galère à entretenir, surtout dans les plis. Avec la tête arrondie ça passe tout seul. Finition premium.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Antoine R.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_79997cda-cf58-4681-9191-7f992714a7a0.png?v=1786545236\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Étanche, je la rince directement sous l'eau après la douche. Ça glisse tout seul, aucune irritation après.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Hugo D.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_1b9441d7-c3e0-4852-b600-75837abd7aa4.png?v=1786545235\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Parfaite pour les zones sensibles : coupe confortable, aucun accroc pour l'instant et un vrai gain de temps.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Nicolas P.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"review-box-{{block.id}}\">\n        <img src=\"https://cdn.shopify.com/s/files/1/1067/3265/0827/files/hf_20260812_143050_bf6401e2-7d03-4041-a5e0-4beb9e9a70a2.png?v=1786545236\" alt=\"Client Raselio\" class=\"product-image-{{block.id}}\">\n        <div>\n          <div class=\"review-text-{{block.id}}\">\"Je stressais de me tailler là au rasoir. Avec Raselio j'ai arrêté d'appréhender : pas de coupure ni de rougeur pour moi, même sur les zones les plus sensibles.\"</div>\n          <div class=\"trustpilot-container-{{block.id}}\">\n            <span class=\"trustpilot-name-{{block.id}}\">Julien F.</span>\n            <div class=\"trustpilot-stars-{{block.id}}\"><img src=\"https://cdn.shopify.com/s/files/1/0862/4694/9130/files/stars-5_1.svg?v=1756194428\" alt=\"5 étoiles\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"arrow-{{block.id}} right\" onclick=\"nextReview{{block.id}}()\">›</div>\n  </div>\n<script>\n  (function(){\n    var idx = 0;\n    var wrap = document.getElementById('carouselWrapper{{block.id}}');\n    var boxes = wrap.querySelectorAll('.review-box-{{block.id}}');\n    var total = boxes.length;\n    var startX, endX;\n    function update(){ wrap.style.transform = 'translateX(' + (-idx * 100) + '%)'; }\n    window.nextReview{{block.id}} = function(){ idx = (idx + 1) % total; update(); };\n    window.prevReview{{block.id}} = function(){ idx = (idx - 1 + total) % total; update(); };\n    window.startTouch{{block.id}} = function(e){ startX = e.touches[0].clientX; };\n    window.moveTouch{{block.id}} = function(e){ endX = e.touches[0].clientX; if (startX - endX > 50) { nextReview{{block.id}}(); } else if (endX - startX > 50) { prevReview{{block.id}}(); } };\n    window.endTouch{{block.id}} = function(){ startX = 0; endX = 0; };\n    setInterval(function(){ nextReview{{block.id}}(); }, 5000);\n  })();\n</script>"
          }
        },
